local function makeDraggable(dragHandle, targetFrame, scaleObj, onClickCallback)
	local dragging = false
	local moved = false
	local dragInput, dragStart, startAbsX, startAbsY

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragInput = input
			dragStart = input.Position

			local cam = workspace.CurrentCamera
			local viewSize = cam and cam.ViewportSize or Vector2.new(1280, 720)
			local pos = targetFrame.Position
			startAbsX = pos.X.Scale * viewSize.X + pos.X.Offset
			startAbsY = pos.Y.Scale * viewSize.Y + pos.Y.Offset

			if scaleObj then
				TweenService:Create(scaleObj, TWEEN_PRESS, { Scale = 0.95 }):Play()
			end
			if dragHandle == LogoPill then
				playRipple(LogoPill, input.Position, Color3.fromRGB(255, 255, 255))
			end
		end
	end)

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 6 then
				moved = true
				local cam = workspace.CurrentCamera
				local viewSize = cam and cam.ViewportSize or Vector2.new(1280, 720)

				-- Khóa vị trí để không bao giờ kéo trượt mất khỏi màn hình điện thoại
				local halfW = targetFrame.AbsoluteSize.X * 0.5
				local fullH = targetFrame.AbsoluteSize.Y
				local minX = halfW + 4
				local maxX = math.max(minX, viewSize.X - halfW - 4)
				local minY = 4
				local maxY = math.max(minY, viewSize.Y - fullH - 4)

				local clampedX = math.clamp(startAbsX + delta.X, minX, maxX)
				local clampedY = math.clamp(startAbsY + delta.Y, minY, maxY)
				targetFrame.Position = UDim2.fromOffset(clampedX, clampedY)
			end
		end
	end))

	trackConn(UserInputService.InputEnded:Connect(function(input)
		if input == dragInput then
			if scaleObj then
				TweenService:Create(scaleObj, TWEEN_RELEASE, { Scale = 1 }):Play()
			end
			if dragging and not moved and onClickCallback then
				onClickCallback()
			end
			dragging = false
			dragInput = nil
		end
	end))
end

