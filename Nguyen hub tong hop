local function applyGodToCharacter(char)
	if not char or not godModeEnabled then return end
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	if not hum or not godModeEnabled then return end

	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	end)

	if not char:FindFirstChild("NguyenHub_GodShield") then
		local ff = Instance.new("ForceField")
		ff.Name = "NguyenHub_GodShield"
		ff.Visible = false
		ff.Parent = char
	end

	-- Tắt CanTouch 1 lần và nghe ChildAdded (không quét lại mỗi khung hình)
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanTouch = false
		end
	end

	if godChildConn then godChildConn:Disconnect() end
	godChildConn = char.ChildAdded:Connect(function(child)
		if godModeEnabled and child:IsA("BasePart") then
			child.CanTouch = false
		end
	end)

	if healthConn then healthConn:Disconnect() end
	healthConn = hum.HealthChanged:Connect(function()
		if godModeEnabled and hum.Parent then
			if hum.MaxHealth <= 0 then hum.MaxHealth = 100 end
			if hum.Health < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
		end
	end)
end

local function disableGodMode()
	godModeEnabled = false
	styleToggleButton(GodBtn, GodStroke, false, "BẤT TỬ 1.0: BẬT", "BẤT TỬ 1.0: TẮT")

	if godConn then godConn:Disconnect() godConn = nil end
	if healthConn then healthConn:Disconnect() healthConn = nil end
	if godChildConn then godChildConn:Disconnect() godChildConn = nil end

	local char = LocalPlayer.Character
	if char then
		local ff = char:FindFirstChild("NguyenHub_GodShield")
		if ff then ff:Destroy() end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
			end)
		end
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanTouch = true
			end
		end
	end
	setStatus("Đã tắt Bất Tử", Color3.fromRGB(165, 165, 180))
end

local function enableGodMode()
	godModeEnabled = true
	styleToggleButton(GodBtn, GodStroke, true, "BẤT TỬ 1.0: BẬT", "BẤT TỬ 1.0: TẮT", Color3.fromRGB(0, 255, 140))
	setStatus("Bất tử kích hoạt", Color3.fromRGB(0, 255, 140))

	if LocalPlayer.Character then
		applyGodToCharacter(LocalPlayer.Character)
	end

	if godConn then godConn:Disconnect() end
	godConn = RunService.Heartbeat:Connect(function()
		if not godModeEnabled then return end
		local char = LocalPlayer.Character
		if not char then return end

		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			if hum.MaxHealth <= 0 then hum.MaxHealth = 100 end
			if hum.Health < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
		end

		if not char:FindFirstChild("NguyenHub_GodShield") then
			local ff = Instance.new("ForceField")
			ff.Name = "NguyenHub_GodShield"
			ff.Visible = false
			ff.Parent = char
		end
	end)
end

-- Nhìn Trong Đêm (có khóa chống lặp vô hạn LightingChanged)
local function applyFullbright()
	if updatingLighting then return end
	updatingLighting = true
	pcall(function()
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(205, 205, 205)
		Lighting.OutdoorAmbient = Color3.fromRGB(205, 205, 205)
	end)
	updatingLighting = false
end

local function setNightVision(state)
	if nightVisionEnabled == state then return end
	nightVisionEnabled = state

	if nightVisionEnabled then
		savedLighting = {
			Brightness = Lighting.Brightness,
			ClockTime = Lighting.ClockTime,
			FogEnd = Lighting.FogEnd,
			GlobalShadows = Lighting.GlobalShadows,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient
		}

		applyFullbright()
		if lightingConn then lightingConn:Disconnect() end
		lightingConn = Lighting.LightingChanged:Connect(function()
			if nightVisionEnabled and not updatingLighting then
				applyFullbright()
			end
		end)

		styleToggleButton(NightBtn, NightStroke, true, "NHÌN TRONG ĐÊM: BẬT", "NHÌN TRONG ĐÊM: TẮT", Color3.fromRGB(0, 225, 255))
		setStatus("Đã bật Nhìn Trong Đêm", Color3.fromRGB(0, 225, 255))
	else
		if lightingConn then lightingConn:Disconnect() lightingConn = nil end
		if savedLighting then
			updatingLighting = true
			pcall(function()
				Lighting.Brightness = savedLighting.Brightness
				Lighting.ClockTime = savedLighting.ClockTime
				Lighting.FogEnd = savedLighting.FogEnd
				Lighting.GlobalShadows = savedLighting.GlobalShadows
				Lighting.Ambient = savedLighting.Ambient
				Lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
			end)
			updatingLighting = false
			savedLighting = nil
