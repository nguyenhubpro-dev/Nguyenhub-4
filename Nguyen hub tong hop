	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(56, 56, 72)
	stroke.Thickness = 1.2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = btn

	attachClickEffect(btn, Color3.fromRGB(255, 255, 255), 0.95)
	return btn, stroke
end

local function styleToggleButton(btn, stroke, isOn, onText, offText, onColor)
	local activeCol = onColor or Color3.fromRGB(0, 255, 140)
	local offCol = Color3.fromRGB(255, 90, 90)
	local targetCol = isOn and activeCol or offCol
	local targetBg = isOn and Color3.fromRGB(24, 46, 38) or Color3.fromRGB(32, 32, 44)

	btn.Text = isOn and onText or offText
	TweenService:Create(btn, TweenInfo.new(0.18), {
		TextColor3 = targetCol,
		BackgroundColor3 = targetBg
	}):Play()
	TweenService:Create(stroke, TweenInfo.new(0.18), {
		Color = targetCol
	}):Play()
end

-- Quản lý 4 Tab với hiệu ứng chuyển trang mượt
local tabButtons = {}
local tabPages = {}
local activeTab = 0

local function switchTab(tabIndex)
	if activeTab == tabIndex then return end
	activeTab = tabIndex

	for i, page in ipairs(tabPages) do
		local active = (i == tabIndex)
		page.Visible = active
		local btn = tabButtons[i]
		TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = active and Color3.fromRGB(0, 175, 105) or Color3.fromRGB(30, 30, 42),
			TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 198)
		}):Play()

		if active then
			local pScale = page:FindFirstChildOfClass("UIScale")
			if pScale then
				pScale.Scale = 0.94
				TweenService:Create(pScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
					Scale = 1
				}):Play()
			end
		end
	end
end

