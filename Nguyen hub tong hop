				end)
			else
				setStatus("Không thấy nhân vật!", Color3.fromRGB(255, 85, 85))
			end
		end)

		TpBtn.MouseButton1Click:Connect(function()
			local targetCF = slotTable[index]
			if not targetCF then
				setStatus("Ô " .. tostring(index) .. " đang trống!", Color3.fromRGB(255, 85, 85))
				return
			end
			local char = LocalPlayer.Character
