local function startFly()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	stopAirWalk()
	stopFly()

	flying = true
	styleToggleButton(FlyBtn, FlyStroke, true, "FLY: BẬT", "FLY: TẮT", Color3.fromRGB(0, 255, 140))
	setStatus("Đã bật Fly tự do", Color3.fromRGB(0, 255, 140))

	hum.PlatformStand = true
	local maxForce = Vector3.new(9e9, 9e9, 9e9)

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.P = 9e4
	bodyGyro.MaxTorque = maxForce
	bodyGyro.CFrame = hrp.CFrame
	bodyGyro.Parent = hrp

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = maxForce
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = hrp

	flyConn = RunService.Heartbeat:Connect(function()
		if not flying or not hrp.Parent or hum.Health <= 0 then
			stopFly()
			return
		end

		-- Luôn lấy CurrentCamera động để tránh lỗi khi map đổi Camera
		local cam = workspace.CurrentCamera
		if not cam then return end

		local camCF = cam.CFrame
		bodyGyro.CFrame = camCF

		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0.01 then
			local look = camCF.LookVector
			local right = camCF.RightVector
			local flatLookRaw = Vector3.new(look.X, 0, look.Z)
			local flatRightRaw = Vector3.new(right.X, 0, right.Z)

			local flatLook = flatLookRaw.Magnitude > 0.001 and flatLookRaw.Unit or Vector3.new(0, 0, -1)
			local flatRight = flatRightRaw.Magnitude > 0.001 and flatRightRaw.Unit or Vector3.new(1, 0, 0)

			local flyDir = (look * moveDir:Dot(flatLook)) + (right * moveDir:Dot(flatRight))
			if flyDir.Magnitude > 0.001 then
				bodyVelocity.Velocity = flyDir.Unit * flySpeed
			end
		else
			bodyVelocity.Velocity = Vector3.zero
		end
	end)
end

