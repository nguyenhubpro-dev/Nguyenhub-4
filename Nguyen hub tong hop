-- HỆ THỐNG HIỆU ỨNG BẤM (RIPPLE + NHÚN UISCALE)
-- ==========================================
local TWEEN_PRESS = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_RELEASE = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TWEEN_RIPPLE = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function playRipple(guiBtn, inputPos, rippleColor)
	local absPos = guiBtn.AbsolutePosition
	local absSize = guiBtn.AbsoluteSize
	local relX = math.clamp(inputPos.X - absPos.X, 0, absSize.X)
	local relY = math.clamp(inputPos.Y - absPos.Y, 0, absSize.Y)

	local maxDim = math.max(absSize.X, absSize.Y) * 2.1

	local ripple = Instance.new("Frame")
	ripple.Name = "Ripple"
	ripple.AnchorPoint = Vector2.new(0.5, 0.5)
	ripple.Position = UDim2.fromOffset(relX, relY)
	ripple.Size = UDim2.fromOffset(0, 0)
	ripple.BackgroundColor3 = rippleColor or Color3.fromRGB(255, 255, 255)
	ripple.BackgroundTransparency = 0.65
	ripple.BorderSizePixel = 0
	ripple.ZIndex = guiBtn.ZIndex + 2
	ripple.Parent = guiBtn
	Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)

	local tween = TweenService:Create(ripple, TWEEN_RIPPLE, {
		Size = UDim2.fromOffset(maxDim, maxDim),
		BackgroundTransparency = 1
	})
	tween:Play()
	tween.Completed:Connect(function()
		if ripple then ripple:Destroy() end
	end)
end

local function attachClickEffect(btn, rippleColor, pressScale)
	btn.ClipsDescendants = true
	local scaleObj = btn:FindFirstChildOfClass("UIScale")
	if not scaleObj then
		scaleObj = Instance.new("UIScale")
		scaleObj.Scale = 1
		scaleObj.Parent = btn
	end

	local targetScale = pressScale or 0.94

	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			TweenService:Create(scaleObj, TWEEN_PRESS, { Scale = targetScale }):Play()
			playRipple(btn, input.Position, rippleColor)
		end
	end)

	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			TweenService:Create(scaleObj, TWEEN_RELEASE, { Scale = 1 }):Play()
		end
	end)

	btn.MouseLeave:Connect(function()
		if scaleObj.Scale ~= 1 then
			TweenService:Create(scaleObj, TWEEN_RELEASE, { Scale = 1 }):Play()
		end
	end)
end

