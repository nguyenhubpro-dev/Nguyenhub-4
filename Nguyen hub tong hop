				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hrp.CFrame = targetCF
				setStatus("Đã TP tới Ô " .. tostring(index), Color3.fromRGB(0, 215, 255))
