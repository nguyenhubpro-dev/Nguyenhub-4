local function cacheNoclipCharacter(char)
	table.clear(noclipParts)
	table.clear(noclipOriginalCollide)
	if not char then return end

	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BasePart") then
			noclipOriginalCollide[obj] = obj.CanCollide
			table.insert(noclipParts, obj)
		end
	end

	if noclipDescConn then noclipDescConn:Disconnect() end
	noclipDescConn = char.DescendantAdded:Connect(function(obj)
		if noclip and obj:IsA("BasePart") then
			noclipOriginalCollide[obj] = obj.CanCollide
			table.insert(noclipParts, obj)
		end
	end)
end

local function setNoclip(state)
	noclip = state
	if noclip then
		styleToggleButton(NoclipBtn, NoclipStroke, true, "NOCLIP: BẬT", "NOCLIP: TẮT", Color3.fromRGB(0, 255, 140))
		setStatus("Đã bật Noclip", Color3.fromRGB(0, 255, 140))

		cacheNoclipCharacter(LocalPlayer.Character)

		if noclipConn then noclipConn:Disconnect() end
		noclipConn = RunService.Stepped:Connect(function()
			for i = #noclipParts, 1, -1 do
				local part = noclipParts[i]
				if part and part.Parent then
					if part.CanCollide then
						part.CanCollide = false
					end
				else
					table.remove(noclipParts, i)
				end
			end
		end)
	else
		styleToggleButton(NoclipBtn, NoclipStroke, false, "NOCLIP: BẬT", "NOCLIP: TẮT")

		if noclipConn then noclipConn:Disconnect() noclipConn = nil end
		if noclipDescConn then noclipDescConn:Disconnect() noclipDescConn = nil end

		for part, origState in pairs(noclipOriginalCollide) do
			if part and part.Parent then
				part.CanCollide = origState
			end
		end
		table.clear(noclipParts)
		table.clear(noclipOriginalCollide)
		setStatus("Đã tắt Noclip", Color3.fromRGB(165, 165, 180))
	end
end

